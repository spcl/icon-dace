prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
cflags=-I${prefix}/include
fcflags=@FPP_INCOPT@${prefix}/include @CDI_F90_INTERFACE_FCFLAGS@
libs=-L${exec_prefix}/lib -lcdipio     -lcdi    -lnetcdf   -lm  -lvelocity_cpu -lopenblas -lnetcdff -lnetcdf
threads_libs=
threads_cflags=
szlib_cflags=
szlib_libs=
netcdf_root=
netcdf_cflags=
netcdf_libs= -lnetcdf
grib_api_cflags=
grib_api_libs=
eccodes_cflags=
eccodes_libs=
yaxt_fc_include=
yaxt_fc_lib=
yaxt_c_cflags=
yaxt_c_libs=
ppm_core_cflags=
ppm_core_libs=
aux_libs= -lm  -lvelocity_cpu -lopenblas -lnetcdff -lnetcdf
cdipio_build_cc=/apps/ault/spack/opt/spack/linux-centos8-zen/gcc-8.4.1/gcc-10.2.0-fqf4ze2mfclmx6e7ehrjckznpoqnevmi/bin/gcc
cdipio_build_cflags=-g -O2
cdipio_build_cppflags= 
cdipio_build_ldflags=-L/scratch/pmazumde/gitspace/icon-artifacts/velocity/integrate_meh
cdipio_build_libs=-lm  -lvelocity_cpu -lopenblas -lnetcdff -lnetcdf
cdipio_build_fc=/apps/ault/spack/opt/spack/linux-centos8-zen/gcc-8.4.1/gcc-10.2.0-fqf4ze2mfclmx6e7ehrjckznpoqnevmi/bin/gfortran
cdipio_build_fcflags=-DDACE_SUBST_ENABLE -g -I/scratch/wbenjami/dafy/sdfg_gpu/spack/opt/spack/linux-centos8-zen2/gcc-10.2.0/netcdf-fortran-4.6.0-p7jdeag2groulzasdfqnokx2qiris3zh/include -I/scratch/wbenjami/dafy/sdfg_gpu/spack/opt/spack/linux-centos8-zen2/gcc-10.2.0/netcdf-c-4.9.2-zynxjqlltpkunevnlaltrm7kfqlwjgpu/include -O2 -std=legacy
cdipio_build_f77=no
cdipio_build_fflags=
cdipio_build_cxx=no
cdipio_build_cxxflags=
cdipio_build_enable_grib=yes
cdipio_build_enable_cgribex=yes
cdipio_build_enable_service=yes
cdipio_build_enable_extra=yes
cdipio_build_enable_ieg=yes

Name: cdipio
Description: CDI-PIO is the MPI-parallel layer of CDI
URL: 
Version: 2.4.0
Requires: 
Libs: ${libs}
Cflags: ${cflags}
FCflags: ${fcflags}

